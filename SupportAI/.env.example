# Настройки SupportAI. Всё необязательно: без файла .env проект запускается с этими же значениями.
# start.bat сам создаёт .env из этого файла при первом запуске.

# Где хранится база данных SQLite (путь от корня проекта). Файл создаётся автоматически.
SUPPORTAI_DB_PATH=backend/data/supportai.db

# Адреса сайта, которым разрешено обращаться к API (через запятую).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Заполнить пустую базу демонстрационными данными при первом запуске: true или false.
SEED_DEMO_DATA=true

# --- Для следующих этапов (сейчас не используется) ---
# AI_API_KEY=
